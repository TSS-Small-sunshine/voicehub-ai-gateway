# ============================================================
# VoiceHub AI Gateway 环境变量模板
# 使用：cp .env.example .env 后逐项填写；.env 已被 gitignore，绝不提交
# ============================================================

# ---- VoiceHub 主仓库（必填）----
VOICEHUB_API_BASE_URL=https://your-voicehub-domain.example.com
# 主仓管理后台 → API Key 管理 创建，勾选 ai-review:read + ai-review:write
VOICEHUB_API_KEY=vhub_your_voicehub_api_key_here

# ---- LLM API Key（OpenAI 兼容）----
# 也可登录管理台在「供应商」页配置（加密落库）；此处 env 注入优先级更高
LLM_API_KEY=sk-your-llm-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=5
LLM_MAX_TOKENS=512

# ---- 管理台（【P0】安全基石，首次部署必须先完成本节）----
# 加密根密钥：openssl rand -hex 32 生成，64 位十六进制。
# 用途：供应商 API Key Fernet 加密 + 名册学号 HMAC。
# ⚠️ 泄露 = 全部密钥与名册数据失守。离线保管、勿入日志/git、轮换需重加密存量数据（见 README 安全手册）。
ADMIN_SECRET=
# 首启管理员账号密码：仅首次启动时创建并强制首登改密；创建完成后建议从 .env 删除这两行
ADMIN_INIT_USER=
ADMIN_INIT_PASS=

# ---- 轮询 ----
POLL_INTERVAL_SECONDS=30
POLL_BATCH_SIZE=20
# 轮询场景（逗号分隔；song/language 需主仓 Phase 3 状态机支持后再开）
REVIEW_SCENES=register,note
# REVIEW 冷却（秒）：冷却期内同一待审项不重审，防无限调用 LLM
REVIEW_COOLDOWN_SECONDS=300

# ---- L3 搜索（语种低置信兜底；留空则跳过 L3）----
TAVILY_API_KEY=

# ---- 数据库（默认 SQLite 零运维；并发瓶颈时仅改连接串即切 PostgreSQL）----
DATABASE_URL=sqlite:///./data/ai_review.db
# 管理台独立库（留空=与 DATABASE_URL 同库，推荐保持默认）
GATEWAY_DATABASE_URL=

# ---- 日志 ----
LOG_LEVEL=INFO

# ---- Caddy 入口（docker compose 读取）----
# 有域名且 443 公网可达时改为你的域名，自动签 Let's Encrypt；默认 :443 自签
#SITE_ADDR=:443

# 提示：轮询间隔/抽查周期/置信阈值/语种白名单/日志保留期等运行期参数，
# 登录管理台「设置」页即可热调整（存 DB，优先级高于 env），无需改本文件。
