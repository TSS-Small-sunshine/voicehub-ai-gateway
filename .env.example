# LLM API Key（OpenAI 兼容：DeepSeek/GLM/Kimi/通义千问...）
LLM_API_KEY=sk-your-llm-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=5
LLM_MAX_TOKENS=512

# VoiceHub 主仓库
VOICEHUB_API_BASE_URL=https://your-voicehub-domain.example.com
VOICEHUB_API_KEY=vhub_your_voicehub_api_key_here

# L3 搜索（语种低置信兜底；留空则跳过 L3）
TAVILY_API_KEY=

# 轮询
POLL_INTERVAL_SECONDS=30
POLL_BATCH_SIZE=20
# 轮询场景（逗号分隔；song/language 需主仓 Phase 3 状态机支持后再开）
REVIEW_SCENES=register,note
# REVIEW 冷却（秒）：冷却期内同一待审项不重审，防无限调用 LLM
REVIEW_COOLDOWN_SECONDS=300

# 审核日志数据库（默认 SQLite）
DATABASE_URL=sqlite:///./data/ai_review.db

# 日志
LOG_LEVEL=INFO